# =====================================================================
#  Copia este archivo como .env y cambia los valores.
#  El .env NUNCA se sube a git (ya está en el .gitignore).
# =====================================================================

# --- Base de datos (MySQL 8) -------------------------------------------
# Formato: mysql+pymysql://USUARIO:CLAVE@HOST:PUERTO/BASE?charset=utf8mb4
# En AWS, HOST es el endpoint de RDS (algo como biblioteca.xxxx.us-east-1.rds.amazonaws.com)
DATABASE_URL=mysql+pymysql://biblio_app:cambia-esta-clave@localhost:3306/biblioteca?charset=utf8mb4

# --- JWT ------------------------------------------------------------------
# Mínimo 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-random-de-al-menos-32-caracteres

# --- Hora de Chile ----------------------------------------------------------
# Los servidores de AWS andan en UTC: sin esto, vencimientos y multas salen corridos.
ZONA_HORARIA=America/Santiago

# --- Reglas del negocio (vienen del contrato) ---------------------------------
MAX_PRESTAMOS_ACTIVOS=3
DIAS_PRESTAMO=14
MULTA_POR_DIA=500

# --- Servidor de desarrollo (python run.py) -----------------------------------
# HOST=0.0.0.0 para probar desde un celular conectado a tu misma wifi
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

# --- CORS (solo importa si algún día hay un cliente web) ------------------------
CORS_ORIGINS=*

# --- Pruebas contra MySQL (opcional) --------------------------------------------
# Si la defines, pytest usa esta base (¡se BORRA entera en cada corrida!).
# Si no, las pruebas usan SQLite en memoria.
# TEST_DATABASE_URL=mysql+pymysql://biblio_app:cambia-esta-clave@localhost:3306/biblioteca_test?charset=utf8mb4
